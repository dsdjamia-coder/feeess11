{
  "entities": {
    "Setting": {
      "title": "Setting",
      "description": "Institution level settings including branding, session registry, and portal configs.",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "institutionName": { "type": "string" },
        "regNo": { "type": "string" },
        "place": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "aboutText": { "type": "string" },
        "logoUrl": { "type": "string" },
        "activeAcademicYear": { "type": "string" },
        "defaultFee": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    },
    "Staff": {
      "title": "Staff",
      "description": "Teaching and administrative staff members.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "type": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "photoUrl": { "type": "string" },
        "status": { "type": "string" },
        "assignedClass": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "StaffAccess": {
      "title": "StaffAccess",
      "description": "Permissions and access control for staff members keyed by Custom Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "staffId": { "type": "string" },
        "username": { "type": "string" },
        "displayUsername": { "type": "string" },
        "loginId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "canCollect": { "type": "boolean" },
        "canManageResults": { "type": "boolean" },
        "canAccessWorksheet": { "type": "boolean" },
        "canAccessAttendance": { "type": "boolean" },
        "canAccessAcademicPlan": { "type": "boolean" },
        "canAccessActivity": { "type": "boolean" },
        "canAccessEvaluation": { "type": "boolean" },
        "canAccessAdmin": { "type": "boolean" },
        "actLikeSuperAdmin": { "type": "boolean" },
        "dutyClasses": { "type": "array" }
      }
    },
    "Student": {
      "title": "Student",
      "description": "Student master profile.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "admissionNo": { "type": "string" },
        "class": { "type": "string" },
        "rollNo": { "type": "string" },
        "gender": { "type": "string" },
        "phone": { "type": "string" },
        "guardianName": { "type": "string" },
        "dob": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Graduated", "Discontinued"] },
        "photoUrl": { "type": "string" },
        "concessionAmount": { "type": "number" },
        "academicYear": { "type": "string" },
        "academicYears": { "type": "object" },
        "continuityLog": { "type": "array" },
        "discontinuationDetails": { "type": "object" },
        "readmissionDetails": { "type": "object" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "admissionNo"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Fee payment transactions.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "admissionNo": { "type": "string" },
        "class": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string" },
        "paymentMode": { "type": "string" },
        "receiptNo": { "type": "string" },
        "academicYear": { "type": "string" },
        "feeItems": { "type": "array" },
        "collectorName": { "type": "string" },
        "collectorEmail": { "type": "string" },
        "description": { "type": "string" },
        "remarks": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["studentId", "amount", "paymentDate"]
    },
    "PublicDirectoryEntry": {
      "title": "PublicDirectoryEntry",
      "description": "Teachers, Committee members, and Public contacts displayed on website.",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "photoUrl": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name"]
    },
    "ExamResult": {
      "title": "ExamResult",
      "description": "Exam result evaluation record for a student.",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "studentId": { "type": "string" },
        "admissionNo": { "type": "string" },
        "studentName": { "type": "string" },
        "class": { "type": "string" },
        "academicYear": { "type": "string" },
        "marks": { "type": "object" },
        "total": { "type": "number" },
        "percentage": { "type": "number" },
        "grade": { "type": "string" },
        "rank": { "type": "number" },
        "status": { "type": "string" },
        "published": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["examId", "studentId"]
    },
    "SystemNotification": {
      "title": "SystemNotification",
      "description": "Announcements and alerts posted for students and staff.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "target": { "type": "string" },
        "targetClass": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "message"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit trail for administrative and financial operations.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "user": { "type": "string" },
        "role": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["action", "timestamp"]
    },
    "CompanyPublicCatalog": {
      "title": "CompanyPublicCatalog",
      "description": "Publicly readable subscription plans, promotional offers, and company contact channels managed by the platform owner.",
      "type": "object",
      "properties": {
        "offerBanner": { "type": "object" },
        "plans": { "type": "array" },
        "contact": { "type": "object" },
        "selfSignupConfig": { "type": "object" },
        "updatedBy": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string" }
      }
    },
    "CompanyPageShowcase": {
      "title": "CompanyPageShowcase",
      "description": "Per-page showcase screenshots (up to 5 images) displayed in the Root Public Gateway interactive preview.",
      "type": "object",
      "properties": {
        "pageKey": {
          "type": "string",
          "enum": [
            "public",
            "admin",
            "official",
            "collection",
            "student",
            "result",
            "attendance",
            "academicPlan",
            "worksheet",
            "studentActivity",
            "classroomEvaluation"
          ]
        },
        "images": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 160 }
      },
      "required": ["pageKey", "images"]
    },
    "AuthCredential": {
      "title": "AuthCredential",
      "description": "Server-only custom username credential vault storing salted scrypt password hashes and deterministic Auth UIDs. Inaccessible to clients.",
      "type": "object",
      "properties": {
        "keyHash": { "type": "string" },
        "username": { "type": "string", "maxLength": 60 },
        "displayUsername": { "type": "string", "maxLength": 60 },
        "passwordSalt": { "type": "string" },
        "passwordHash": { "type": "string" },
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "staff"] },
        "institutionId": { "type": "string" },
        "institutionName": { "type": "string" },
        "staffId": { "type": "string" },
        "displayName": { "type": "string" },
        "isActive": { "type": "boolean" },
        "failedAttempts": { "type": "number" },
        "lockUntilMs": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["keyHash", "username", "passwordSalt", "passwordHash", "uid", "role", "institutionId"]
    },
    "UpgradeRequest": {
      "title": "UpgradeRequest",
      "description": "In-app plan upgrade request submitted by a Basic plan institution administrator for Company Owner approval.",
      "type": "object",
      "properties": {
        "institutionId": { "type": "string" },
        "institutionName": { "type": "string" },
        "institutionPlace": { "type": "string" },
        "currentPlanTier": { "type": "string", "enum": ["basic", "premium"] },
        "currentPlanName": { "type": "string" },
        "requestedPlanId": { "type": "string" },
        "requestedPlanName": { "type": "string" },
        "requestedFeature": { "type": "string" },
        "contactPhone": { "type": "string" },
        "note": { "type": "string" },
        "requestedBy": { "type": "string" },
        "requestedByUid": { "type": "string" },
        "usageSnapshot": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "contacted", "approved", "declined"] },
        "createdAtIso": { "type": "string" },
        "updatedAtIso": { "type": "string" }
      },
      "required": ["institutionId", "requestedPlanName", "status"]
    }
  },
  "firestore": {
    "/authCredentials/{keyHash}": {
      "schema": { "$ref": "#/entities/AuthCredential" },
      "description": "Server-only custom username authentication vault accessed strictly via Firebase Cloud Functions"
    },
    "/upgradeRequests/{requestId}": {
      "schema": { "$ref": "#/entities/UpgradeRequest" },
      "description": "In-app upgrade requests from institutions managed by the Company Owner"
    },
    "/company/publicCatalog": {
      "schema": { "$ref": "#/entities/CompanyPublicCatalog" },
      "description": "Publicly readable subscription plans and support contact channels"
    },
    "/company/publicCatalog/showcases/{pageKey}": {
      "schema": { "$ref": "#/entities/CompanyPageShowcase" },
      "description": "Per-page showcase screenshots managed by the platform owner and publicly readable on the Root Gateway"
    },
    "/institutions/{institutionId}/settings/{docId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "Global and module settings for the institution"
    },
    "/institutions/{institutionId}/staff/{docId}": {
      "schema": { "$ref": "#/entities/Staff" },
      "description": "Staff and teacher profiles"
    },
    "/institutions/{institutionId}/staffAccess/{docId}": {
      "schema": { "$ref": "#/entities/StaffAccess" },
      "description": "RBAC and access definitions for staff"
    },
    "/institutions/{institutionId}/students/{docId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student roster and profiles"
    },
    "/institutions/{institutionId}/payments/{docId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Fee payment records"
    },
    "/institutions/{institutionId}/publicDirectory/{docId}": {
      "schema": { "$ref": "#/entities/PublicDirectoryEntry" },
      "description": "Directory entries shown on the public site"
    },
    "/institutions/{institutionId}/examResults/{docId}": {
      "schema": { "$ref": "#/entities/ExamResult" },
      "description": "Student marks and examination records"
    },
    "/institutions/{institutionId}/systemNotifications/{docId}": {
      "schema": { "$ref": "#/entities/SystemNotification" },
      "description": "Notice board and notifications"
    },
    "/institutions/{institutionId}/auditLogs/{docId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit trail logs"
    }
  }
}
