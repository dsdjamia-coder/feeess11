rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Authenticated non-anonymous user (Admin / Staff)
    function isAuthenticated() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function hasEmailIdentity() {
      return isAuthenticated() && request.auth.token.email != null;
    }

    function companyConfigRef() {
      return /databases/$(database)/documents/company/config;
    }

    function companyConfigData() {
      return get(companyConfigRef()).data;
    }

    function isCompanyOwner() {
      return hasEmailIdentity()
        && exists(companyConfigRef())
        && (
          (
            'email' in companyConfigData()
            && companyConfigData().email is string
            && companyConfigData().email.lower() == request.auth.token.email.lower()
          )
          || (
            'ownersIndex' in companyConfigData()
            && companyConfigData().ownersIndex is map
            && (
              companyConfigData().ownersIndex[request.auth.token.email] == true
              || companyConfigData().ownersIndex[request.auth.token.email.lower()] == true
            )
          )
        );
    }

    function institutionMetaRef(institutionId) {
      return /databases/$(database)/documents/institutions/$(institutionId);
    }

    function institutionMetaExists(institutionId) {
      return exists(institutionMetaRef(institutionId));
    }

    function institutionMetaData(institutionId) {
      return get(institutionMetaRef(institutionId)).data;
    }

    function isInstitutionActiveAndUnexpired(institutionId) {
      return !institutionMetaExists(institutionId)
        || (
          (!('status' in institutionMetaData(institutionId)) || institutionMetaData(institutionId).status == 'active')
          && (!('isActive' in institutionMetaData(institutionId)) || institutionMetaData(institutionId).isActive != false)
          && (
            ('isLifetime' in institutionMetaData(institutionId) && institutionMetaData(institutionId).isLifetime == true)
            || !('expiryTimestamp' in institutionMetaData(institutionId))
            || institutionMetaData(institutionId).expiryTimestamp == null
            || (institutionMetaData(institutionId).expiryTimestamp is timestamp && request.time <= institutionMetaData(institutionId).expiryTimestamp)
            || (institutionMetaData(institutionId).expiryTimestamp is number && request.time.toMillis() <= institutionMetaData(institutionId).expiryTimestamp)
          )
        );
    }

    function canAccessTenant(institutionId) {
      return isInstitutionActiveAndUnexpired(institutionId) || isCompanyOwner();
    }

    function adminAuthRef(institutionId) {
      return /databases/$(database)/documents/institutions/$(institutionId)/settings/adminAuth;
    }

    function adminData(institutionId) {
      return get(adminAuthRef(institutionId)).data;
    }

    function isSuperAdminDoc(institutionId) {
      return hasEmailIdentity()
        && exists(adminAuthRef(institutionId))
        && (
          (
            'email' in adminData(institutionId)
            && adminData(institutionId).email is string
            && adminData(institutionId).email.lower() == request.auth.token.email.lower()
          )
          || (
            'adminsIndex' in adminData(institutionId)
            && adminData(institutionId).adminsIndex is map
            && (
              adminData(institutionId).adminsIndex[request.auth.token.email] == true
              || adminData(institutionId).adminsIndex[request.auth.token.email.lower()] == true
            )
          )
        );
    }

    function staffAccessRef(institutionId) {
      return /databases/$(database)/documents/institutions/$(institutionId)/staffAccess/$(request.auth.token.email);
    }

    function staffAccessLowerRef(institutionId) {
      return /databases/$(database)/documents/institutions/$(institutionId)/staffAccess/$(request.auth.token.email.lower());
    }

    function hasStaffAccessDoc(institutionId) {
      return hasEmailIdentity() && (exists(staffAccessRef(institutionId)) || exists(staffAccessLowerRef(institutionId)));
    }

    function staffData(institutionId) {
      return exists(staffAccessRef(institutionId))
        ? get(staffAccessRef(institutionId)).data
        : get(staffAccessLowerRef(institutionId)).data;
    }

    function isStaff(institutionId) {
      return hasStaffAccessDoc(institutionId) && staffData(institutionId).isActive != false;
    }

    function isStaffManager(institutionId) {
      return isStaff(institutionId)
        && (staffData(institutionId).canAccessAdmin == true || staffData(institutionId).actLikeSuperAdmin == true);
    }

    function isAdmin(institutionId) {
      return isCompanyOwner() || isSuperAdminDoc(institutionId) || isStaffManager(institutionId);
    }

    function isCollector(institutionId) {
      return isAdmin(institutionId) || (isStaff(institutionId) && staffData(institutionId).canCollect == true);
    }

    function isInternalUsernameEmail() {
      return hasEmailIdentity() && request.auth.token.email.lower().matches('.*@[a-z0-9-_]+\\.internal$');
    }

    function authEmailUsernamePrefix() {
      return request.auth.token.email.lower().split('@')[0];
    }

    function matchesCollectorIdentity(institutionId, data) {
      return (
        ('collectedByUid' in data && data.collectedByUid is string && data.collectedByUid == request.auth.uid)
        || (hasEmailIdentity() && 'collectedByEmail' in data && data.collectedByEmail is string && data.collectedByEmail.lower() == request.auth.token.email.lower())
        || (hasEmailIdentity() && 'collectedBy' in data && data.collectedBy is string && (
          data.collectedBy.lower() == request.auth.token.email.lower()
          || (isInternalUsernameEmail() && data.collectedBy.lower() == authEmailUsernamePrefix())
          || (isStaff(institutionId) && (
            ('email' in staffData(institutionId) && staffData(institutionId).email is string && data.collectedBy.lower() == staffData(institutionId).email.lower())
            || ('loginId' in staffData(institutionId) && staffData(institutionId).loginId is string && data.collectedBy.lower() == staffData(institutionId).loginId.lower())
            || ('username' in staffData(institutionId) && staffData(institutionId).username is string && data.collectedBy.lower() == staffData(institutionId).username.lower())
            || ('userKey' in staffData(institutionId) && staffData(institutionId).userKey is string && data.collectedBy.lower() == staffData(institutionId).userKey.lower())
            || ('staffId' in staffData(institutionId) && staffData(institutionId).staffId is string && data.collectedBy.lower() == staffData(institutionId).staffId.lower())
            || ('name' in staffData(institutionId) && staffData(institutionId).name is string && data.collectedBy.lower() == staffData(institutionId).name.lower())
          ))
        ))
      );
    }

    function isRecordCollectorOwner(institutionId, data) {
      return isCollector(institutionId) && matchesCollectorIdentity(institutionId, data);
    }

    function isResultOperator(institutionId) {
      return isAdmin(institutionId) || (isStaff(institutionId) && (staffData(institutionId).canManageResults == true || staffData(institutionId).result == true));
    }

    function canManageAttendance(institutionId) {
      return isAdmin(institutionId) || (isStaff(institutionId) && (staffData(institutionId).canAccessAttendance == true || staffData(institutionId).attendance == true));
    }

    function canManageAcademicPlan(institutionId) {
      return isAdmin(institutionId) || (isStaff(institutionId) && (staffData(institutionId).canAccessAcademicPlan == true || staffData(institutionId).academicPlan == true));
    }

    function canManageActivity(institutionId) {
      return isAdmin(institutionId) || (isStaff(institutionId) && (staffData(institutionId).canAccessActivity == true || staffData(institutionId).studentActivity == true));
    }

    function canManageEvaluation(institutionId) {
      return isAdmin(institutionId) || (isStaff(institutionId) && (staffData(institutionId).canAccessEvaluation == true || staffData(institutionId).evaluation == true));
    }

    function canManageWorksheet(institutionId) {
      return isAdmin(institutionId) || (isStaff(institutionId) && (staffData(institutionId).canAccessWorksheet == true || staffData(institutionId).worksheet == true));
    }

    function isIsoTimestamp(value) {
      return value is timestamp;
    }

    function hasOnlyKeys(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function institutionConfigRef(institutionId) {
      return /databases/$(database)/documents/institutions/$(institutionId)/settings/config;
    }

    function institutionConfigData(institutionId) {
      return get(institutionConfigRef(institutionId)).data;
    }

    function studentPhotoUploadEnabled(institutionId) {
      return exists(institutionConfigRef(institutionId))
        && institutionConfigData(institutionId).allowStudentPhotoUpload == true;
    }

    function studentDetailsEditEnabled(institutionId) {
      return exists(institutionConfigRef(institutionId))
        && institutionConfigData(institutionId).allowStudentDetailsEdit == true;
    }

    function validOptionalPhotoString(val) {
      return val is string && val.size() <= 400000;
    }

    function validStudentPhotoProfileMap(changedKeys) {
      return !('profile' in changedKeys)
        || (
          request.resource.data.profile is map
          && (
            (('profile' in resource.data && resource.data.profile is map)
              && request.resource.data.profile.diff(resource.data.profile).affectedKeys().hasOnly(['photo']))
            || ((!('profile' in resource.data) || !(resource.data.profile is map))
              && request.resource.data.profile.keys().hasOnly(['photo']))
          )
          && (!('photo' in request.resource.data.profile) || validOptionalPhotoString(request.resource.data.profile.photo))
        );
    }

    function validOfficialPhotoString(val) {
      return val is string && val.size() <= 100000;
    }

    function isAllowedStaffSelfPhotoUpdate(institutionId, docId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return hasEmailIdentity()
        && isStaff(institutionId)
        && (
          ('email' in resource.data && resource.data.email is string && resource.data.email.lower() == request.auth.token.email.lower())
          || ('staffId' in staffData(institutionId) && staffData(institutionId).staffId == docId)
        )
        && changed.hasOnly(['photo', 'updatedAt'])
        && (!('photo' in changed) || validOfficialPhotoString(request.resource.data.photo))
        && (!('updatedAt' in changed) || request.resource.data.updatedAt is number || request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is string);
    }

    function validDirectoryValuesPhotoMap(changedKeys) {
      return !('values' in changedKeys)
        || (
          request.resource.data.values is map
          && (
            (('values' in resource.data && resource.data.values is map)
              && request.resource.data.values.diff(resource.data.values).affectedKeys().hasOnly(['photo']))
            || ((!('values' in resource.data) || !(resource.data.values is map))
              && request.resource.data.values.keys().hasOnly(['photo']))
          )
          && (!('photo' in request.resource.data.values) || validOfficialPhotoString(request.resource.data.values.photo))
        );
    }

    function isAllowedDirectorySelfPhotoUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && ('categoryId' in resource.data)
        && changed.hasOnly(['values', 'updatedAt'])
        && (!('updatedAt' in changed) || request.resource.data.updatedAt is number || request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is string)
        && validDirectoryValuesPhotoMap(changed);
    }

    function isAllowedStudentPhotoUpdate(institutionId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && studentPhotoUploadEnabled(institutionId)
        && changed.hasOnly(['photo', 'profile', 'updatedAt'])
        && (!('photo' in changed) || validOptionalPhotoString(request.resource.data.photo))
        && (!('updatedAt' in changed) || request.resource.data.updatedAt is number || request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is string)
        && validStudentPhotoProfileMap(changed);
    }

    function validStudentDetailsProfileMap(changedKeys) {
      let allowedProfileKeys = ['name', 'gender', 'dob', 'adhaar', 'aadhaar', 'father', 'mother', 'mobile', 'phone', 'motherMobile', 'address'];
      return !('profile' in changedKeys)
        || (
          request.resource.data.profile is map
          && (
            (('profile' in resource.data && resource.data.profile is map)
              && request.resource.data.profile.diff(resource.data.profile).affectedKeys().hasOnly(allowedProfileKeys))
            || ((!('profile' in resource.data) || !(resource.data.profile is map))
              && request.resource.data.profile.keys().hasOnly(allowedProfileKeys))
          )
        );
    }

    function isAllowedStudentDetailsUpdate(institutionId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let allowedKeys = ['name', 'gender', 'dob', 'adhaar', 'aadhaar', 'father', 'mother', 'mobile', 'phone', 'motherMobile', 'address', 'profile', 'updatedAt'];
      return isSignedIn()
        && studentDetailsEditEnabled(institutionId)
        && changed.hasOnly(allowedKeys)
        && (!('name' in changed) || (request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80))
        && (!('gender' in changed) || (request.resource.data.gender is string && request.resource.data.gender.size() <= 20))
        && (!('dob' in changed) || (request.resource.data.dob is string && request.resource.data.dob.size() <= 30))
        && (!('adhaar' in changed) || (request.resource.data.adhaar is string && request.resource.data.adhaar.size() <= 20))
        && (!('aadhaar' in changed) || (request.resource.data.aadhaar is string && request.resource.data.aadhaar.size() <= 20))
        && (!('father' in changed) || (request.resource.data.father is string && request.resource.data.father.size() <= 80))
        && (!('mother' in changed) || (request.resource.data.mother is string && request.resource.data.mother.size() <= 80))
        && (!('mobile' in changed) || (request.resource.data.mobile is string && request.resource.data.mobile.size() <= 20))
        && (!('phone' in changed) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20))
        && (!('motherMobile' in changed) || (request.resource.data.motherMobile is string && request.resource.data.motherMobile.size() <= 20))
        && (!('address' in changed) || (request.resource.data.address is string && request.resource.data.address.size() <= 300))
        && (!('updatedAt' in changed) || request.resource.data.updatedAt is number || request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is string)
        && validStudentDetailsProfileMap(changed);
    }

    function validSessionRegistryWrite() {
      return (
          hasOnlyKeys(request.resource.data, ['lastHeartbeatAt', 'updatedAt', 'createdAt', 'sessionId', 'userAgent'])
          && request.resource.data.sessionId is string
          && request.resource.data.userAgent is string
          && isIsoTimestamp(request.resource.data.updatedAt)
        )
        || (
          'sessions' in request.resource.data
          && request.resource.data.sessions is map
        );
    }

    function validPaymentWrite() {
      return request.resource.data.studentId is string
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.paymentDate is string
        && (!('timestamp' in request.resource.data) || request.resource.data.timestamp is number)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is string || request.resource.data.updatedAt is number);
    }

    // --- COMPANY MASTER PORTAL, GLOBAL USER REGISTRY & INSTITUTION REGISTRY ---
    match /company/{docId} {
      allow read, write: if isCompanyOwner();
    }

    match /globalUsers/{loginKey} {
      allow get: if true;
      allow list: if isCompanyOwner();
      allow create, update: if isCompanyOwner() || (
        isAuthenticated()
        && request.resource.data.institutionId is string
        && isAdmin(request.resource.data.institutionId)
        && (resource == null || resource.data.institutionId == request.resource.data.institutionId)
      );
      allow delete: if isCompanyOwner() || (
        isAuthenticated()
        && resource != null
        && resource.data.institutionId is string
        && isAdmin(resource.data.institutionId)
      );
    }

    match /institutions/{institutionId} {
      allow get: if true;
      allow list: if isAuthenticated() || isCompanyOwner();
      allow create, update, delete: if isCompanyOwner();
    }

    // --- INSTITUTION RULES ---

    // 1. Settings Collection
    match /institutions/{institutionId}/settings/{docId} {
      // Company Owner can manage institution settings unconditionally (including during setup/pause)
      allow read, write: if isCompanyOwner();

      // Sensitive admin auth doc is strictly Admin/Super Admin readable and Super Admin/Company Owner writable
      allow read: if docId == 'adminAuth' && canAccessTenant(institutionId) && isAdmin(institutionId);
      allow write: if docId == 'adminAuth' && canAccessTenant(institutionId) && (isCompanyOwner() || isSuperAdminDoc(institutionId));

      // Public settings required by landing page & portal shells (explicit allowlist, excludes adminAuth)
      allow read: if canAccessTenant(institutionId) && docId in [
        'config',
        'content',
        'categoryAuthConfig',
        'pageAccess',
        'websiteContent',
        'institutionConfig',
        'academicYears',
        'sessionControl'
      ];

      // Module-specific configuration documents require an active authenticated or student session
      allow read: if docId != 'adminAuth' && isSignedIn() && canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || isStaff(institutionId)
        || docId in [
          'resultCenter',
          'sessionRegistry',
          'receiptSequence',
          'attendanceConfig',
          'timetableStructure',
          'yearPlanConfig',
          'academicPlanningConfig',
          'activityConfig',
          'taskDefinitions',
          'concessions',
          'feeSettings'
        ]
        || docId.matches('evaluationConfig_.*')
      );

      allow write: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || (docId == 'sessionRegistry' && isSignedIn() && validSessionRegistryWrite())
        || (isResultOperator(institutionId) && docId == 'resultCenter')
        || (isCollector(institutionId) && docId in ['sessionRegistry', 'receiptSequence'])
        || (isCollector(institutionId)
            && docId == 'config'
            && resource != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feeItems'])
            && request.resource.data.feeItems is list)
        || (canManageAttendance(institutionId) && docId == 'timetableStructure')
        || (
          canManageAttendance(institutionId)
          && docId == 'attendanceConfig'
          && (
            (resource == null && !('sessionSchedules' in request.resource.data))
            || (resource != null && !('sessionSchedules' in request.resource.data.diff(resource.data).affectedKeys()))
          )
        )
        || (canManageAcademicPlan(institutionId) && (docId == 'yearPlanConfig' || docId == 'academicPlanningConfig'))
        || (canManageActivity(institutionId) && (docId == 'activityConfig' || docId == 'taskDefinitions'))
        || (canManageEvaluation(institutionId) && docId.matches('evaluationConfig_.*'))
      );
    }

    // 2. Staff Profiles (Public profiles; credentials stored strictly in Firebase Auth)
    match /institutions/{institutionId}/staff/{docId} {
      allow read: if canAccessTenant(institutionId);
      allow create, delete: if canAccessTenant(institutionId) && isAdmin(institutionId);
      allow update: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isAllowedStaffSelfPhotoUpdate(institutionId, docId));
    }

    // 3. Staff Access (Roles & Permissions - scoped to Admin or own signed-in Staff identity)
    match /institutions/{institutionId}/staffAccess/{docId} {
      allow list: if canAccessTenant(institutionId) && isAdmin(institutionId);
      allow get: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || (hasEmailIdentity() && (docId == request.auth.token.email || isStaff(institutionId)))
      );
      allow create, delete: if canAccessTenant(institutionId) && isAdmin(institutionId);
      allow update: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || (
          hasEmailIdentity()
          && docId == request.auth.token.email
          && isStaff(institutionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo', 'updatedAt'])
          && (!('photo' in request.resource.data.diff(resource.data).affectedKeys()) || validOfficialPhotoString(request.resource.data.photo))
          && (!('updatedAt' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.updatedAt is number || request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is string)
        )
      );
    }

    // 4. Student Auth Lookup (Exact single-doc lookup for login; list restricted to Staff/Admin)
    match /institutions/{institutionId}/studentAuthLookup/{docId} {
      allow get: if canAccessTenant(institutionId);
      allow list: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isStaff(institutionId));
      allow write: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isCollector(institutionId));
    }

    // 5. Students (List restricted to Staff/Admin; single-doc get for Student Portal session)
    match /institutions/{institutionId}/students/{docId} {
      allow list: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isStaff(institutionId));
      allow get: if isSignedIn() && canAccessTenant(institutionId);
      allow create, delete: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isCollector(institutionId));
      allow update: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || isCollector(institutionId)
        || isAllowedStudentPhotoUpdate(institutionId)
        || isAllowedStudentDetailsUpdate(institutionId)
      );
    }

    // 6. Student Groups
    match /institutions/{institutionId}/studentGroups/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isCollector(institutionId));
    }

    // 7. Student Notification State (Authenticated student/staff sessions only)
    match /institutions/{institutionId}/studentNotificationState/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if isSignedIn()
        && canAccessTenant(institutionId)
        && hasOnlyKeys(request.resource.data, ['lastMarkedAllReadAt', 'readIds'])
        && (!('lastMarkedAllReadAt' in request.resource.data) || request.resource.data.lastMarkedAllReadAt is number)
        && (!('readIds' in request.resource.data) || request.resource.data.readIds is list);
    }

    // 8. System Notifications (Admin/Staff write only)
    match /institutions/{institutionId}/systemNotifications/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isStaff(institutionId));
    }

    // 9. Payments (Staff/Admin unrestricted read; Admin/Manager or owner collector write/delete)
    match /institutions/{institutionId}/payments/{docId} {
      allow get: if isSignedIn() && canAccessTenant(institutionId);
      allow list: if canAccessTenant(institutionId) && (
        isCollector(institutionId)
        || isAdmin(institutionId)
        || isStaff(institutionId)
        || (isSignedIn() && request.query.limit != null && request.query.limit <= 150)
      );
      allow create: if canAccessTenant(institutionId) && validPaymentWrite() && (isAdmin(institutionId) || isRecordCollectorOwner(institutionId, request.resource.data));
      allow update: if canAccessTenant(institutionId) && validPaymentWrite() && (
        isAdmin(institutionId)
        || (isCollector(institutionId) && matchesCollectorIdentity(institutionId, resource.data) && matchesCollectorIdentity(institutionId, request.resource.data))
      );
      allow delete: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || (isCollector(institutionId) && (resource == null || matchesCollectorIdentity(institutionId, resource.data)))
      );
    }

    // 10. Donations (Staff/Collector read; Admin/Manager or owner collector create/update/delete)
    match /institutions/{institutionId}/donations/{docId} {
      allow read: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isCollector(institutionId) || isStaff(institutionId));
      allow create: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isRecordCollectorOwner(institutionId, request.resource.data));
      allow update: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || (isCollector(institutionId) && matchesCollectorIdentity(institutionId, resource.data) && matchesCollectorIdentity(institutionId, request.resource.data))
      );
      allow delete: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || (isCollector(institutionId) && (resource == null || matchesCollectorIdentity(institutionId, resource.data)))
      );
    }

    // 11. Attendance
    match /institutions/{institutionId}/attendance/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageAttendance(institutionId);
    }

    // 12. Timetables & Classes
    match /institutions/{institutionId}/timetables/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageAcademicPlan(institutionId);
    }

    match /institutions/{institutionId}/classSubjects/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageAcademicPlan(institutionId);
    }

    match /institutions/{institutionId}/yearPlans/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageAcademicPlan(institutionId);
    }

    match /institutions/{institutionId}/syllabusDailyLogs/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageAcademicPlan(institutionId);
    }

    match /institutions/{institutionId}/examTimetables/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageAcademicPlan(institutionId);
    }

    // 13. Activities, Ibadah, Tasks
    match /institutions/{institutionId}/activities/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageActivity(institutionId);
    }

    match /institutions/{institutionId}/ibadah/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageActivity(institutionId);
    }

    match /institutions/{institutionId}/taskCompletions/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageActivity(institutionId);
    }

    match /institutions/{institutionId}/studentCustomBadges/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageActivity(institutionId);
    }

    match /institutions/{institutionId}/studentBonusPoints/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageActivity(institutionId);
    }

    match /institutions/{institutionId}/rewardSettings/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageActivity(institutionId);
    }

    match /institutions/{institutionId}/prayerSettings/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageActivity(institutionId);
    }

    // 14. Evaluations & Impositions
    match /institutions/{institutionId}/evaluations/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageEvaluation(institutionId);
    }

    match /institutions/{institutionId}/impositions/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageEvaluation(institutionId);
    }

    // 15. Worksheets
    match /institutions/{institutionId}/worksheets/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && canManageWorksheet(institutionId);
    }

    // 16. Public Directory (Public read for landing page; auth metadata isolated to admin)
    match /institutions/{institutionId}/publicDirectory/{docId} {
      allow read: if canAccessTenant(institutionId);
      allow create, delete: if canAccessTenant(institutionId) && isAdmin(institutionId);
      allow update: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isAllowedDirectorySelfPhotoUpdate());
    }

    match /institutions/{institutionId}/directoryAuth/{docId} {
      allow read, write: if canAccessTenant(institutionId) && isAdmin(institutionId);
    }

    match /institutions/{institutionId}/pageAccessOverrides/{docId} {
      allow read, write: if canAccessTenant(institutionId) && isAdmin(institutionId);
    }

    // 17. Results & Promotion
    match /institutions/{institutionId}/resultSchemas/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && isResultOperator(institutionId);
    }

    match /institutions/{institutionId}/examResults/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && isResultOperator(institutionId);
    }

    match /institutions/{institutionId}/promotionDecisions/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && isResultOperator(institutionId);
    }

    match /institutions/{institutionId}/studentPhotoSubmissions/{docId} {
      allow list: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isCollector(institutionId));
      allow get: if isSignedIn() && canAccessTenant(institutionId);
      allow create, update: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || isCollector(institutionId)
        || (
          isSignedIn()
          && studentPhotoUploadEnabled(institutionId)
          && exists(/databases/$(database)/documents/institutions/$(institutionId)/students/$(docId))
          && hasOnlyKeys(request.resource.data, ['photo', 'updatedAt'])
          && validOptionalPhotoString(request.resource.data.photo)
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number || request.resource.data.updatedAt is timestamp)
        )
      );
      allow delete: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isCollector(institutionId));
    }

    match /institutions/{institutionId}/collectorPreferences/{docId} {
      allow read, write: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isCollector(institutionId));
    }

    // 18. Academic Years Subcollections
    match /institutions/{institutionId}/academicYears/{yearId}/classes/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && isAdmin(institutionId);
    }

    match /institutions/{institutionId}/academicYears/{yearId}/enrollments/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && (isAdmin(institutionId) || isCollector(institutionId));
    }

    match /institutions/{institutionId}/academicYears/{yearId}/feeItems/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && isAdmin(institutionId);
    }

    match /institutions/{institutionId}/academicYears/{yearId}/payments/{docId} {
      allow get: if isSignedIn() && canAccessTenant(institutionId);
      allow list: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || isCollector(institutionId)
        || isStaff(institutionId)
        || (isSignedIn() && request.query.limit != null && request.query.limit <= 150)
      );
      allow create: if canAccessTenant(institutionId) && validPaymentWrite() && (isAdmin(institutionId) || isRecordCollectorOwner(institutionId, request.resource.data));
      allow update: if canAccessTenant(institutionId) && validPaymentWrite() && (
        isAdmin(institutionId)
        || (isCollector(institutionId) && matchesCollectorIdentity(institutionId, resource.data) && matchesCollectorIdentity(institutionId, request.resource.data))
      );
      allow delete: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || (isCollector(institutionId) && (resource == null || matchesCollectorIdentity(institutionId, resource.data)))
      );
    }

    match /institutions/{institutionId}/years/{yearId}/payments/{docId} {
      allow get: if isSignedIn() && canAccessTenant(institutionId);
      allow list: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || isCollector(institutionId)
        || isStaff(institutionId)
        || (isSignedIn() && request.query.limit != null && request.query.limit <= 150)
      );
      allow create: if canAccessTenant(institutionId) && validPaymentWrite() && (isAdmin(institutionId) || isRecordCollectorOwner(institutionId, request.resource.data));
      allow update: if canAccessTenant(institutionId) && validPaymentWrite() && (
        isAdmin(institutionId)
        || (isCollector(institutionId) && matchesCollectorIdentity(institutionId, resource.data) && matchesCollectorIdentity(institutionId, request.resource.data))
      );
      allow delete: if canAccessTenant(institutionId) && (
        isAdmin(institutionId)
        || (isCollector(institutionId) && (resource == null || matchesCollectorIdentity(institutionId, resource.data)))
      );
    }

    match /institutions/{institutionId}/academicYears/{yearId}/results/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && isResultOperator(institutionId);
    }

    // 19. Audit Logs (Append-only by non-anonymous authenticated Staff/Admin, Admin read-only)
    match /institutions/{institutionId}/auditLogs/{docId} {
      allow read: if canAccessTenant(institutionId) && isAdmin(institutionId);
      allow create: if isAuthenticated() && canAccessTenant(institutionId);
      allow update, delete: if false;
    }

    match /institutions/{institutionId}/transferCertificates/{docId} {
      allow read: if isSignedIn() && canAccessTenant(institutionId);
      allow write: if canAccessTenant(institutionId) && isAdmin(institutionId);
    }

    // Default Deny on all other paths
    match /institutions/{institutionId}/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
